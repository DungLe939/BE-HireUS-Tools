PORT=3000
GEMINI_API_KEY=
# Model ID verified at https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=15000

# Self-hosted faster-whisper; export Python settings separately (service never reads .env).
WHISPER_STT_BASE_URL=http://127.0.0.1:8001
WHISPER_STT_TIMEOUT_MS=60000
# Optional preferred alias; empty keeps WHISPER_STT_TIMEOUT_MS. HTTP deadline, not NFR target.
VMI_STT_TIMEOUT_MS=
# small on every device. Explicit model overrides remain supported; larger CPU models need a measured timeout.
# Real voice i5-12500H/4 threads: <=20s ~2-4.3s; 80s mean12.4s/max13.2s.
# espeak 180s ~7.5s is historical, not a real-voice NFR guarantee.
# 45s headroom / 60s near10s are unmeasured estimates. 180s answer decision remains open.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Unset threads for auto min(4, visible cores/cgroup quota); explicit override remains supported.
# WHISPER_CPU_THREADS=4
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=false
WHISPER_CONDITION_ON_PREVIOUS_TEXT=true
# Empty/off. Optional keywords <=1000 chars, no control characters; not evaluated/enabled.
WHISPER_INITIAL_PROMPT=
# Conservative default pending real-voice refinement accuracy and false-correction review.
VMI_STT_REFINE_ENABLED=false
VMI_REFINE_TIMEOUT_MS=4000
VMI_REFINE_MAX_WORD_EDIT_RATIO=0.35
VMI_REFINE_MIN_LENGTH_RATIO=0.7
VMI_REFINE_MAX_LENGTH_RATIO=1.3
# Use the same limits in Nest and the STT service. Size may be lowered, not raised.
VMI_AUDIO_MAX_BYTES=15728640
VMI_AUDIO_MAX_DURATION_MS=195000
# Self-hosted ZONOS3-Mini (native ggml); see docs/vmi/tts-stt-integration-notes.md.
ZONOS_TTS_BASE_URL=http://127.0.0.1:1919
ZONOS_TTS_TIMEOUT_MS=30000
# Wyatt for both languages, as selected by the user. Not a native Vietnamese voice.
ZONOS_TTS_VOICE_VI=default_34370fd91e3484ef
ZONOS_TTS_VOICE_EN=default_34370fd91e3484ef

# start:dev and start:prod use Node --env-file=.env; create .env before starting.
# A missing .env makes Node exit with an error. Shell env values take precedence.
